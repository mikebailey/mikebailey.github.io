# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Python environment for scripts/ (see pyproject.toml). uv.lock IS committed
# so the CV toolchain is reproducible across machines.
.venv/
__pycache__/
*.py[oc]

# Ignore files created by MacOS
.DS_Store

# Source images (keep local for re-cropping; processed versions are committed)
images/headshot-original.*
